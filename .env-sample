# AI Configuration - Choose ONE option by uncommenting the lines below:

# OPTION 1: vLLM (local server)
# VLLM_ENABLED=true
# VLLM_HOST=http://localhost:8000
# VLLM_MODEL=qwen36-fast

# OPTION 2: Google Gemini (cloud)
# Get your key from: https://aistudio.google.com/apikey
# GOOGLE_API_KEY=your_gemini_api_key_here

# OPTION 3: llama.cpp (local server - compatible with OpenAI API)
# LLAMACPP_ENABLED=true
# LLAMACPP_HOST=http://localhost:8000
# LLAMACPP_MODEL=Qwen3-VL-30B:Instruct:Q4_K_XL

# AI Thinking Mode - set to true to disable model thinking/reasoning
AI_DISABLE_THINKING=false
